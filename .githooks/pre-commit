#!/bin/sh
set -eu

# Guards against accidentally introducing AI assistant config into a repo that
# hasn't adopted it. It does NOT block repos that deliberately track these files.
blocked_patterns='^(AGENTS\.md|CLAUDE\.md|\.agents/|\.claude/|\.cursor/)'

# Explicit per-repo opt-in — for a new project, or an existing repo you're
# deliberately introducing AI files to. Set with:
#   git config hooks.allowAiFiles true
if [ "$(git config --bool hooks.allowAiFiles 2>/dev/null || true)" = "true" ]; then
    exit 0
fi

staged=$(git diff --cached --name-only --diff-filter=ACMR | grep -E "$blocked_patterns" || true)

if [ -z "$staged" ]; then
    exit 0
fi

# Only block files the repo hasn't already adopted. A file that's already in HEAD
# was a conscious decision (shared team docs), so committing changes to it is
# intentional — the accident worth catching is a brand-new AI file appearing.
blocked_files=$(
    printf '%s\n' "$staged" | while IFS= read -r file; do
        [ -n "$file" ] || continue
        git cat-file -e "HEAD:$file" 2>/dev/null || printf '%s\n' "$file"
    done
)

if [ -n "$blocked_files" ]; then
    echo "Blocked AI-related files detected in the staged changes:" >&2
    echo "$blocked_files" >&2
    echo "" >&2
    echo "These aren't tracked in this repo yet. If that's an accident, unstage them." >&2
    echo "If this repo is meant to keep AI files, allow them with:" >&2
    echo "    git config hooks.allowAiFiles true" >&2
    exit 1
fi
