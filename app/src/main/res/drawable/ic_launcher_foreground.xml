<?xml version="1.0" encoding="utf-8"?>
<!-- A downward arrow landing into an open-topped frame: "save this into here".
     Three simple strokes — a stem, a chevron arrowhead, and a three-sided tray open at
     the top.

     The group scale matters. The guaranteed-visible area of an adaptive icon is not the
     centre 72x72 square but a 72dp-diameter CIRCLE, so a mark that fits the square can
     still have its corners shaved off by the launcher's mask — which is exactly what
     happened at full size here: the tray's bottom corners sat ~41 units from the centre
     against a radius of 36. Scaling to 0.78 brings the furthest corner to ~33, inside the
     circle with margin for launchers whose masks are tighter than stock Android's.
     Stroke width is 10 rather than 8 so the mark keeps its weight after shrinking. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.78"
        android:scaleY="0.78">
        <!-- Arrow stem -->
        <path
            android:pathData="M54,24 L54,48"
            android:strokeColor="@color/amber_accent"
            android:strokeWidth="10"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:fillColor="#00000000" />
        <!-- Arrowhead, tip pointing down into the frame's opening -->
        <path
            android:pathData="M38,48 L54,64 L70,48"
            android:strokeColor="@color/amber_accent"
            android:strokeWidth="10"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:fillColor="#00000000" />
        <!-- Open-topped frame: left wall, base, right wall -->
        <path
            android:pathData="M32,56 L32,82 L76,82 L76,56"
            android:strokeColor="@color/amber_accent"
            android:strokeWidth="10"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:fillColor="#00000000" />
    </group>
</vector>
