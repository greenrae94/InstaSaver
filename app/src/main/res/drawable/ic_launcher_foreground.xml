<?xml version="1.0" encoding="utf-8"?>
<!-- A downward arrow landing into an open-topped frame: "save this into here".
     Three simple strokes — a stem, a chevron arrowhead, and a three-sided tray open at
     the top — all kept inside the centre 72x72 safe zone (18,18)-(90,90) of the 108x108
     viewport so the launcher's mask never clips them. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Arrow stem -->
    <path
        android:pathData="M54,24 L54,48"
        android:strokeColor="@color/amber_accent"
        android:strokeWidth="8"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />
    <!-- Arrowhead, tip pointing down into the frame's opening -->
    <path
        android:pathData="M38,48 L54,64 L70,48"
        android:strokeColor="@color/amber_accent"
        android:strokeWidth="8"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />
    <!-- Open-topped frame: left wall, base, right wall -->
    <path
        android:pathData="M32,56 L32,82 L76,82 L76,56"
        android:strokeColor="@color/amber_accent"
        android:strokeWidth="8"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />
</vector>
