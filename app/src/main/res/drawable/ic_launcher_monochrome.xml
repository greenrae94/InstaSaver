<?xml version="1.0" encoding="utf-8"?>
<!-- Same silhouette as the foreground, for Android 13+ themed icons. The system replaces
     whatever color is drawn here with the user's chosen tint, so the exact color is
     irrelevant — it only needs to be fully opaque where the mark should show.

     The group scale must match the foreground's exactly, or the themed icon and the
     normal icon would be different sizes. See ic_launcher_foreground.xml for why 0.78. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.78"
        android:scaleY="0.78">
        <path
            android:pathData="M54,24 L54,48"
            android:strokeColor="#FF000000"
            android:strokeWidth="10"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:fillColor="#00000000" />
        <path
            android:pathData="M38,48 L54,64 L70,48"
            android:strokeColor="#FF000000"
            android:strokeWidth="10"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:fillColor="#00000000" />
        <path
            android:pathData="M32,56 L32,82 L76,82 L76,56"
            android:strokeColor="#FF000000"
            android:strokeWidth="10"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:fillColor="#00000000" />
    </group>
</vector>
