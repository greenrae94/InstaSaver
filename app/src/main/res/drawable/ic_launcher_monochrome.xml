<?xml version="1.0" encoding="utf-8"?>
<!-- Same silhouette as the foreground, for Android 13+ themed icons. The system replaces
     whatever color is drawn here with the user's chosen tint, so the exact color is
     irrelevant — it only needs to be fully opaque where the mark should show. -->
